<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- Android 12+ launch theme -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">

        <!-- Plain white background -->
        <item name="android:windowSplashScreenBackground">@android:color/white</item>

        <!-- Transparent icon so the ReliefLink launcher logo is not shown -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash</item>

        <!-- No branding image -->
        <item name="android:windowSplashScreenBrandingImage">@null</item>

        <!-- Keep the window white while Flutter starts -->
        <item name="android:windowBackground">@android:color/white</item>

    </style>

    <!-- Normal Flutter theme -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

</resources>